+  // Print the throughput every 5 seconds until the workers finish their
+  // transactions (RUNMODE_OPS) or the runtime has elapsed (RUNMODE_TIME).
+  {
+    unsigned long elapsed_time = 0;
+    size_t commits = 0;
+    size_t end = 0;
+    do {
+      sleep(5);
+      size_t current_commits = 0;
+      for (size_t i = 0; i < nthreads; i++)
+        current_commits += workers[i]->get_ntxn_commits();
+      elapsed_time += 5;
+      const double tmp_thput = (double)(current_commits - commits) / 5.0;
+      cerr << "time: " << elapsed_time << " throughput: " << tmp_thput << " ops/sec" << endl;
+      commits = current_commits;
+      for (size_t i = 0; i < nthreads; i++)
+        if (workers[i]->check_bench_end())
+          end = 1;
+    } while (!end && (run_mode != RUNMODE_TIME || elapsed_time < runtime));
