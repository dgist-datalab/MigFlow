+/*
+ * Migration rate limiter: promotion, demotion and NUMA-fault migration
+ * consume one global budget of /proc/sys/vm/migration_rate_limit_MBps
+ * (0 = unlimited).
+ */
+unsigned int sysctl_migration_rate_limit_mbps;
+static DEFINE_SPINLOCK(mig_rl_lock);
+static unsigned long mig_rl_win_start;
+static unsigned long mig_rl_win_pages;
+
+/* How many pages may still migrate in the current 1-second window.
+ * This only queries the budget; callers charge the pages that actually
+ * moved with migration_rl_charge(). */
+unsigned int migration_rl_avail(unsigned int nr_pages)
+{
+	unsigned long limit, flags, used;
+	unsigned int mbps = READ_ONCE(sysctl_migration_rate_limit_mbps);
+
+	if (!mbps)
+		return nr_pages;
+	limit = (unsigned long)mbps << (20 - PAGE_SHIFT);
+
+	spin_lock_irqsave(&mig_rl_lock, flags);
+	if (!mig_rl_win_start || time_after(jiffies, mig_rl_win_start + HZ)) {
+		mig_rl_win_start = jiffies ? jiffies : 1;
+		mig_rl_win_pages = 0;
+	}
+	used = mig_rl_win_pages;
+	spin_unlock_irqrestore(&mig_rl_lock, flags);
+
+	if (used >= limit)
+		return 0;
+	return min_t(unsigned long, nr_pages, limit - used);
+}
+
+/*
+ * Reclaim-context variant: waits for the next window when the current one
+ * is exhausted. Returns 0 only when the calling kthread is asked to stop.
+ */
+unsigned int migration_rl_avail_wait(unsigned int nr_pages)
+{
+	unsigned int allow;
+
+	if (!READ_ONCE(sysctl_migration_rate_limit_mbps))
+		return nr_pages;
+	while (!(allow = migration_rl_avail(nr_pages))) {
+		if (kthread_should_stop())
+			return 0;
+		schedule_timeout_uninterruptible(HZ / 10);
+	}
+	return allow;
+}
+
+/* Charge pages that actually migrated against the current window. */
+void migration_rl_charge(unsigned int nr_pages)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(sysctl_migration_rate_limit_mbps) || !nr_pages)
+		return;
+
+	spin_lock_irqsave(&mig_rl_lock, flags);
+	if (!mig_rl_win_start || time_after(jiffies, mig_rl_win_start + HZ)) {
+		mig_rl_win_start = jiffies ? jiffies : 1;
+		mig_rl_win_pages = 0;
+	}
+	mig_rl_win_pages += nr_pages;
+	spin_unlock_irqrestore(&mig_rl_lock, flags);
+}
+
+static struct ctl_table mig_rl_table[] = {
+	{
+		.procname	= "migration_rate_limit_MBps",
+		.data		= &sysctl_migration_rate_limit_mbps,
+		.maxlen		= sizeof(unsigned int),
+		.mode		= 0644,
+		.proc_handler	= proc_douintvec,
+	},
+	{}
+};
+
+static int __init mig_rl_init(void)
+{
+	register_sysctl("vm", mig_rl_table);
+	return 0;
+}
+late_initcall(mig_rl_init);
