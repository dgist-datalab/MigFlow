 /*
+ * Trim @folios to the unified migration budget. Folios over budget are moved
+ * to @overflow, which the callers treat as not migrated. Returns the number
+ * of pages kept.
+ */
+static unsigned int migration_rl_trim(struct list_head *folios,
+				      struct list_head *overflow)
+{
+	struct folio *folio, *tmp;
+	unsigned int nr = 0, allow, kept = 0;
+
+	list_for_each_entry(folio, folios, lru)
+		nr += folio_nr_pages(folio);
+	/* kswapd waits for budget; direct reclaim takes what is left */
+	allow = current_is_kswapd() ? migration_rl_avail_wait(nr) : migration_rl_avail(nr);
+	if (allow >= nr)
+		return nr;
+	list_for_each_entry_safe(folio, tmp, folios, lru) {
+		if (kept + folio_nr_pages(folio) > allow)
+			list_move(&folio->lru, overflow);
+		else
+			kept += folio_nr_pages(folio);
+	}
+	return kept;
+}
