+	soft_gfp = gfp | __GFP_NOWARN;
+	soft_gfp &= ~(__GFP_DIRECT_RECLAIM | __GFP_NOFAIL);
+
+	page = __alloc_pages(soft_gfp, order, numa_node_id(), &nmask);
+
+	return page;
+}
